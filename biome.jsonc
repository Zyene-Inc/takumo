{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      // Tests and evals: fixtures and assertions read better inline.
      "includes": [
        "**/__tests__/**",
        "**/test/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/app/evals/**"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off",
            "useTopLevelRegex": "off"
          },
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noMisplacedAssertion": "off", "useAwait": "off" }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**/*",
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!docs",
      "!apps/email/.react-email",
      "!vendor",
      "!services/mail/dist",
      "!services/mail/dist-test",
      "!services/engine"
    ]
  }
}
