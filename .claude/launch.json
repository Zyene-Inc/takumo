{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "takumo-app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "turbo",
        "dev",
        "--filter=app",
        "--filter=web",
        "--ui=stream"
      ],
      "port": 3000
    },
    {
      "name": "takumo-engine",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:engine"],
      "port": 8000
    }
  ]
}
