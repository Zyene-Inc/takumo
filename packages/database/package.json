{
  "name": "@repo/database",
  "version": "0.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "analyze": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "build": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test:db": "vitest run --no-file-parallelism __tests__/reader.db.test.ts __tests__/reader-isolation.db.test.ts __tests__/reader-wrapper.db.test.ts",
    "generate-demo": "tsx scripts/generate-demo.ts",
    "check:ask-sql": "tsx scripts/check-ask-sql.ts",
    "check:db-access": "tsx scripts/check-db-access.ts",
    "test": "vitest run __tests__/demo.test.ts __tests__/sql-allow.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@t3-oss/env-nextjs": "^0.13.10",
    "libpg-query": "17.7.4",
    "pg": "^8.23.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.5.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
