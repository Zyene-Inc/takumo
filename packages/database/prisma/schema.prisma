// Takumo factory schema.
// Every tenant-owned row carries `orgId` (the WorkOS organization ID).
// Queries must always filter by orgId; RLS in prisma/sql/ is the backstop.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  planner
  estimator
  operator
}

enum Provenance {
  data // read from an uploaded file or connected system
  stated // told to us by a person
  assumed // a default Takumo filled in; needs review
}

enum OrderStatus {
  open
  in_progress
  done
  cancelled
}

enum QuoteStatus {
  open
  won
  lost
}

enum FactStatus {
  pending
  approved
  superseded
  rejected
}

// ---------------------------------------------------------------------------
// Orgs & members (mirrored from WorkOS: on shop creation and via apps/api webhook)
// ---------------------------------------------------------------------------

model Org {
  id                   String    @id // WorkOS organization ID (org_…)
  name                 String
  // trial | shop | pro | plant (see packages/payments/plans.ts)
  plan                 String    @default("trial")
  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Stripe's subscription status: trialing | active | past_due | canceled | unpaid | …
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // When the subscription went past due (the payment grace runs from here).
  pastDueSince         DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members            Member[]
  workCenters        WorkCenter[]
  calendarDays       CalendarDay[]
  operators          Operator[]
  operatorDays       OperatorDay[]
  materials          Material[]
  customers          Customer[]
  parts              Part[]
  routings           Routing[]
  bomLines           BomLine[]
  orders             Order[]
  jobs               Job[]
  quotes             Quote[]
  rfqs               Rfq[]
  rfqLines           RfqLine[]
  sources            Source[]
  docChunks          DocChunk[]
  facts              Fact[]
  notes              Note[]
  connections        Connection[]
  aiUsage            AiUsage[]
  conversations      Conversation[]
  scheduleRuns       ScheduleRun[]
  inboundAddresses   InboundAddress[]
  inboundMessages    InboundMessage[]
  erpReports         ErpReport[]
  stockLevels        StockLevel[]
  purchaseOrderLines PurchaseOrderLine[]
  rfqFiles           RfqFile[]
  customerPos        CustomerPo[]
  customerPoFiles    CustomerPoFile[]
  uploadParts        UploadPart[]
  shopSettings       ShopSettings?
  notifyPrefs        NotifyPrefs[]
  emailLinkUses      EmailLinkUse[]
  briefClicks        BriefClick[]
  alertWatch         AlertWatch?
  alertEvents        AlertEvent[]
  alertSent          AlertSent[]
  phoneNumbers       PhoneNumber[]
  phoneMessages      PhoneMessage[]
}

model Member {
  id        String   @id @default(uuid())
  orgId     String
  userId    String // WorkOS user ID (user_…)
  role      Role     @default(planner)
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ---------------------------------------------------------------------------
// Shop model
// ---------------------------------------------------------------------------

model WorkCenter {
  id                  String     @id @default(uuid())
  orgId               String
  org                 Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String
  // The record's id in the shop's ERP: a rename there updates this record
  // instead of creating a second one.
  externalId          String?
  type                String? // e.g. "cnc_mill", "lathe", "press_brake"
  hourlyRate          Decimal?   @db.Decimal(10, 2)
  efficiency          Float      @default(1.0)
  shifts              Json? // [{ "days": [1,2,3,4,5], "start": "07:00", "end": "15:30" }]
  // Largest part it takes, in inches: { x, y, z } or { diameter, length }.
  envelope            Json?
  // Tightest tolerance it holds, in inches (e.g. 0.0005).
  toleranceIn         Float?
  // People needed while it runs: 0.5 = one person runs two machines.
  operatorsPerMachine Float      @default(1)
  // Runs need nobody once set up (lights-out), if someone who can leave
  // machines running is in that day.
  unattendedRuns      Boolean    @default(false)
  provenance          Provenance @default(data)
  sourceId            String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt            DateTime?

  calendar CalendarDay[]
  routings Routing[]

  @@unique([orgId, externalId])
  @@unique([orgId, name])
  @@index([orgId])
}

model CalendarDay {
  id             String   @id @default(uuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workCenterId   String
  date           DateTime @db.Date
  availableHours Float
  reason         String? // holiday, maintenance, breakdown

  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([workCenterId, date])
  @@index([orgId])
}

model Operator {
  id               String    @id @default(uuid())
  orgId            String
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  // The ERP's employee id: how nightly reports find the same person.
  externalId       String?
  active           Boolean   @default(true)
  skills           String[]
  hourlyRate       Decimal?  @db.Decimal(10, 2)
  // When they work: { "start": "15:30", "end": "24:00", "days": [1,2,3,4,5] }
  // (ISO weekdays, 1 = Monday, like WorkCenter.shifts; an end at or before the
  // start runs past midnight). Empty: any time a machine they run is running.
  shifts           Json?
  // Machines they're qualified to run (WorkCenter ids).
  workCenterIds    String[]  @default([])
  // Can set up a machine and leave it running (lights-out, several machines).
  canRunUnattended Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt         DateTime?

  days OperatorDay[]

  @@unique([orgId, externalId])
  @@index([orgId])
}

// An operator's day off or short day (vacation, sick), like CalendarDay for
// machines: hours they work that day (0 = off).
model OperatorDay {
  id         String   @id @default(uuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  operatorId String
  date       DateTime @db.Date
  hours      Float    @default(0)
  reason     String?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([operatorId, date])
  @@index([orgId])
}

model Material {
  id           String     @id @default(uuid())
  orgId        String
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  // The record's id in the shop's ERP: a rename there updates this record
  // instead of creating a second one.
  externalId   String?
  spec         String?
  unitCost     Decimal?   @db.Decimal(12, 4)
  unit         String     @default("ea")
  leadTimeDays Int?
  provenance   Provenance @default(data)
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt     DateTime?

  parts              Part[]
  rfqLines           RfqLine[]
  stock              StockLevel[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([orgId, externalId])
  @@unique([orgId, name])
  @@index([orgId])
}

model Customer {
  id              String    @id @default(uuid())
  orgId           String
  org             Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  // The record's id in the shop's ERP: a rename there updates this record
  // instead of creating a second one.
  externalId      String?
  paymentTermDays Int?
  // Lowest margin the owner accepts for this customer (0.25 = 25%).
  marginFloor     Float?
  // How to recognise their email: contact addresses and company domains,
  // from the ERP's customer report (no typing).
  emails          String[]  @default([])
  domains         String[]  @default([])
  createdAt       DateTime  @default(now())
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt        DateTime?

  parts       Part[]
  orders      Order[]
  quotes      Quote[]
  rfqs        Rfq[]
  customerPos CustomerPo[]

  @@unique([orgId, externalId])
  @@unique([orgId, name])
  @@index([orgId])
}

model Part {
  id                 String    @id @default(uuid())
  orgId              String
  org                Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partNo             String
  rev                String    @default("A")
  description        String?
  customerId         String?
  materialId         String?
  // Stock one part uses (e.g. 0.5 ft of bar), for material availability.
  materialQtyPerUnit Float?
  materialUnit       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt           DateTime?

  customer  Customer? @relation(fields: [customerId], references: [id])
  material  Material? @relation(fields: [materialId], references: [id])
  routings  Routing[]
  orders    Order[]
  quotes    Quote[]
  rfqLines  RfqLine[]
  bomParent BomLine[] @relation("BomParent")
  bomChild  BomLine[] @relation("BomChild")

  @@unique([orgId, partNo, rev])
  @@index([orgId])
}

model Routing {
  id               String     @id @default(uuid())
  orgId            String
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partId           String
  seq              Int // operation number: 10, 20, 30…
  workCenterId     String
  setupMin         Float
  runMinPerUnit    Float
  altWorkCenterIds String[]
  provenance       Provenance @default(data)
  confidence       Float      @default(1.0)
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt         DateTime?

  part       Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@unique([partId, seq])
  @@index([orgId])
}

model BomLine {
  id           String @id @default(uuid())
  orgId        String
  org          Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentPartId String
  childPartId  String
  qty          Float

  parent Part @relation("BomParent", fields: [parentPartId], references: [id], onDelete: Cascade)
  child  Part @relation("BomChild", fields: [childPartId], references: [id])

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Demand & history
// ---------------------------------------------------------------------------

model Order {
  id         String      @id @default(uuid())
  orgId      String
  org        Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderNo    String
  customerId String?
  partId     String
  qty        Int
  dueDate    DateTime    @db.Date
  price      Decimal?    @db.Decimal(12, 2)
  // The customer's purchase order number, as the ERP has it.
  customerPo String?
  priority   Int         @default(0)
  status     OrderStatus @default(open)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt   DateTime?

  customer Customer? @relation(fields: [customerId], references: [id])
  part     Part      @relation(fields: [partId], references: [id])
  jobs     Job[]

  @@unique([orgId, orderNo])
  @@index([orgId, status])
}

// One row per routing operation actually run: the source for recalibration.
model Job {
  id                   String    @id @default(uuid())
  orgId                String
  org                  Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderId              String
  routingSeq           Int
  workCenterId         String?
  plannedStart         DateTime?
  plannedEnd           DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  actualSetupMin       Float?
  actualRunMin         Float?
  qtyGood              Int?
  qtyScrap             Int?
  // What the model said when the job was planned or logged, so its error can
  // be measured against what actually happened (calibration).
  plannedSetupMin      Float?
  plannedRunMinPerUnit Float?
  loggedBy             String?
  // A planner fixed this operation to workCenterId and plannedStart's day on
  // the schedule board; re-planning keeps it there.
  pinned               Boolean   @default(false)
  // From the ERP's open-operations report: the operation is closed there
  // (finished or cancelled), or this many parts are already through it.
  closedAt             DateTime?
  qtyDone              Int?
  // Last time the shop's ERP report updated it; read-only in Takumo then.
  syncedAt             DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, routingSeq])
  @@index([orgId])
  @@index([orgId, actualEnd])
}

model Quote {
  id                String      @id @default(uuid())
  orgId             String
  org               Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  quoteNo           String
  customerId        String?
  partId            String?
  qty               Int
  price             Decimal?    @db.Decimal(12, 2)
  leadTimeDays      Int?
  estCost           Decimal?    @db.Decimal(12, 2)
  actualCost        Decimal?    @db.Decimal(12, 2)
  status            QuoteStatus @default(open)
  quotedAt          DateTime    @default(now())
  rfqId             String?
  // Quote Copilot: what Takumo suggested, kept beside what was sent so we can
  // measure how often estimators accept the draft with small edits.
  draftPrice        Decimal?    @db.Decimal(12, 2)
  draftLeadTimeDays Int?
  // Every quantity quoted: [{ qty, unitPrice, price, draftUnitPrice }].
  breaks            Json?
  approvedBy        String?

  customer Customer? @relation(fields: [customerId], references: [id])
  part     Part?     @relation(fields: [partId], references: [id])
  rfq      Rfq?      @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  rfqLine  RfqLine?

  @@unique([orgId, quoteNo])
  @@index([orgId, status])
  @@index([rfqId])
}

// A request for quote: an email or a document from a customer. Quote Copilot
// reads it into lines, drafts a price and lead time per line, and an
// estimator approves the quote.
model Rfq {
  id            String    @id @default(uuid())
  orgId         String
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number        Int // RFQ-0001, per shop
  // email | portal | form | phone | upload | paste
  source        String
  sourceId      String?
  fileName      String?
  subject       String?
  sender        String?
  // The text Takumo read the RFQ from.
  body          String
  customerName  String?
  customerId    String?
  contact       String?
  requestedDate DateTime? @db.Date
  notes         String?
  // The model's raw reading, kept for audit.
  extracted     Json?
  // reading | review | drafted | quoted | won | lost | declined | failed
  status        String    @default("reading")
  error         String?
  createdBy     String?
  receivedAt    DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  // The earlier RFQ this one repeats (same sender and files within 7 days).
  duplicateOfId String?
  // The draft reply in the mailbox (RfqReply in lib/quotes/types.ts).
  reply         Json?
  // When the draft was first ready, the reply sent, and won/lost decided.
  draftedAt     DateTime?
  sentAt        DateTime?
  decidedAt     DateTime?

  customer Customer? @relation(fields: [customerId], references: [id])
  lines    RfqLine[]
  quotes   Quote[]
  files    RfqFile[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

// One part on an RFQ, with the quantities asked for.
model RfqLine {
  id           String  @id @default(uuid())
  orgId        String
  org          Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rfqId        String
  lineNo       Int
  partNo       String?
  rev          String?
  description  String?
  materialText String? // as the customer wrote it
  qtys         Int[]
  tolerances   String?
  finish       String?
  notes        String?
  // Matched shop records (null = a part or material the shop hasn't made).
  partId       String?
  materialId   String?
  // Estimator inputs: operations for a new part ([QuoteOperation]), outside
  // processes ([OutsideProcess]), stock per part or material cost per part,
  // and a margin override.
  routing      Json?
  outside      Json?
  usagePerPart Float?
  materialCost Float?
  targetMargin Float?
  // The engine's estimate ({ estimatedAt, request summary, response }).
  draft        Json?
  // What the estimator approved: { leadTimeDays, breaks: [{ qty, unitPrice }] }.
  final        Json?
  // What was read from the drawing, with where (DrawingReading in types.ts).
  drawing      Json?
  // The drawing file this line was read from.
  fileId       String?
  quoteId      String? @unique

  rfq      Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  part     Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  quote    Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([rfqId, lineNo])
  @@index([orgId])
}

// A file that came with an RFQ (drawing, 3D model, spec), kept so it can be
// read again and shown beside the quote.
model RfqFile {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  name      String
  mediaType String
  size      Int
  sha256    String
  // drawing | model | document | image | other
  kind      String   @default("other")
  pages     Int?
  data      Bytes
  createdAt DateTime @default(now())

  @@index([orgId, rfqId])
  @@index([orgId, sha256])
}

// A piece of a file being uploaded in parts (requests are capped at 4.5 MB
// on the host). Put together and deleted when the upload is submitted; left
// over pieces are removed by the daily cron.
model UploadPart {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadId  String
  fileIndex Int
  partIndex Int
  name      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([orgId, uploadId, fileIndex, partIndex])
  @@index([createdAt])
}

// A purchase order a customer sent (by email or upload): read, checked
// against the quote, and laid out ready to enter in the ERP. Takumo never
// creates the order itself; the ERP's report brings it back once entered.
model CustomerPo {
  id           String    @id @default(uuid())
  orgId        String
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // PO-0001, per shop (Takumo's own number for it).
  number       Int
  // The customer's PO number, as written on the PO.
  poNo         String?
  customerId   String?
  customerName String?
  contact      String?
  sender       String?
  subject      String?
  // The text Takumo read the PO from.
  body         String
  // email | upload | paste
  source       String
  sourceId     String?
  // reading | review | entered | rejected | failed
  status       String    @default("reading")
  error        String?
  // [PoLine] and PO-level checks (lib/orders/types.ts).
  lines        Json?
  checks       Json?
  // Ship-to, terms, notes; the mail thread it came in.
  extracted    Json?
  receivedAt   DateTime  @default(now())
  enteredAt    DateTime?
  enteredBy    String?
  createdBy    String?
  updatedAt    DateTime  @default(now()) @updatedAt

  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  files    CustomerPoFile[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model CustomerPoFile {
  id        String     @id @default(uuid())
  orgId     String
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  poId      String
  po        CustomerPo @relation(fields: [poId], references: [id], onDelete: Cascade)
  name      String
  mediaType String
  size      Int
  sha256    String
  data      Bytes
  createdAt DateTime   @default(now())

  @@index([orgId, poId])
}

// How a shop quotes: one row per shop, every field optional with a default
// in lib/quotes/settings.ts.
model ShopSettings {
  orgId             String   @id
  org               Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  quoteValidityDays Int?
  materialMarkup    Float?
  laborRate         Float?
  // Margin for drafts when the shop has no won quotes with costs yet
  // (0.25 = 25%); the estimator can still change it per line.
  defaultMargin     Float?
  toleranceIn       Float?
  certifications    String[] @default([])
  // [{ process, supplier, leadTimeDays, costPerPart, lotCharge }]
  outsideProcesses  Json?
  signature         String?
  replyIntro        String?
  // Learned from the RFQ inbox: senders an estimator quoted ("Quote it") and
  // senders they blocked. An address, or @domain for a company domain.
  knownSenders      String[] @default([])
  blockedSenders    String[] @default([])
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Knowledge
// ---------------------------------------------------------------------------

model Source {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  type      String // "upload" | "quickbooks" | "gmail" | …
  filePath  String? // Supabase Storage path
  status    String   @default("pending") // pending | parsing | ready | failed
  profile   String? // quotes | routings | travelers | sops | erp_export | generic
  summary   String?
  createdAt DateTime @default(now())

  chunks DocChunk[]

  @@index([orgId])
}

model DocChunk {
  id        String                       @id @default(uuid())
  orgId     String
  org       Org                          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceId  String
  content   String
  page      Int?
  meta      Json?
  // Created and indexed by prisma/sql/001_pgvector_rls.sql
  embedding Unsupported("vector(1024)")?

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Tribal knowledge with history: new facts supersede old ones instead of
// overwriting them. A fact about a model parameter (a routing's setup time, a
// machine's rate) changes that record when a supervisor approves it.
model Fact {
  id               String     @id @default(uuid())
  orgId            String
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number           Int // F-12, per shop
  subjectType      String // "routing" | "work_center" | "part" | "material" | "customer" | "shop"
  subjectId        String
  // How people refer to the subject, e.g. "P-1001 rev B op 10 (HAAS-VF2)".
  subjectLabel     String
  attribute        String // e.g. "setupMin", or "note" for knowledge in words
  value            Json
  // The record's value when the fact was proposed, to show the change.
  previousValue    Json?
  // chat | voice | note | floor | recalibration | manual
  source           String     @default("manual")
  statedBy         String? // WorkOS user ID, or null for Takumo (recalibration)
  evidence         String?
  noteId           String?
  status           FactStatus @default(pending)
  supersedesFactId String?
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  validFrom        DateTime   @default(now())
  validTo          DateTime?
  createdAt        DateTime   @default(now())

  note Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, subjectType, subjectId])
  @@index([orgId, status])
}

// A voice note or typed note from the shop floor. Takumo reads it for facts.
model Note {
  id          String   @id @default(uuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        String // "voice" | "typed"
  text        String
  durationSec Float?
  // The operation it was logged with, if any.
  jobId       String?
  createdBy   String?
  // reading | done | failed
  status      String   @default("reading")
  error       String?
  // Where it came from: null (the app), "sms" or "whatsapp" (F6.1), and who
  // sent it when that wasn't someone signed in (an operator's phone).
  channel     String?
  senderName  String?
  createdAt   DateTime @default(now())

  facts Fact[]

  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Agent
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages Message[]

  @@index([orgId, userId])
  @@index([orgId, userId, updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String // "user" | "assistant" | "tool"
  content        String
  toolCalls      Json?
  citations      Json?
  // The full UI message (text, tool calls and results, artifacts), so a
  // conversation re-opens exactly as it was shown.
  parts          Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ScheduleRun {
  id           String   @id @default(uuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  objective    String
  input        Json
  output       Json?
  solverStatus String?
  createdBy    String?
  createdAt    DateTime @default(now())
  // Capacity checks: did the planner agree with the answer? ("agree" | "disagree")
  verdict      String?
  verdictNote  String?
  verdictBy    String?

  @@index([orgId, objective, createdAt])
}

// ---------------------------------------------------------------------------
// Connectors
// ---------------------------------------------------------------------------

// A shop's link to an outside system (QuickBooks, Gmail). Tokens are
// encrypted with CONNECTOR_ENCRYPTION_KEY and never leave the server.
model Connection {
  id           String    @id @default(uuid())
  orgId        String
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider     String // "quickbooks" | "gmail"
  // connected | error | disconnected
  status       String    @default("connected")
  // The company (QuickBooks realm) or mailbox it's connected to.
  account      String
  accountLabel String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  // Provider settings, e.g. Gmail's search for RFQs.
  settings     Json?
  lastSyncAt   DateTime?
  // { created, updated, skipped, notes } from the last sync.
  lastResult   Json?
  lastError    String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([orgId, provider])
}

// One Claude call (or one Ask Takumo answer): tokens and what it cost, for
// per-shop AI spend and the monthly cap (AI_MONTHLY_BUDGET_USD).
model AiUsage {
  id               String   @id @default(uuid())
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId           String?
  // ask | rfq_read | routing_proposal | note_read
  feature          String
  model            String
  inputTokens      Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  outputTokens     Int
  costUsd          Decimal  @db.Decimal(10, 4)
  createdAt        DateTime @default(now())

  @@index([orgId, createdAt])
}

// A shop's email addresses on the inbound domain: erp-<token>@ for nightly
// ERP reports, rfq-<token>@ for forwarded RFQs (services/mail delivers them).
model InboundAddress {
  id             String    @id @default(uuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind           String // erp | rfq | ask | docs
  token          String    @unique
  // Who may send to it: addresses ("reports@shop.com") or domains ("@shop.com").
  allowedSenders String[]  @default([])
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?

  @@unique([orgId, kind])
}

// Every message received, once (by content hash): what happened to it.
model InboundMessage {
  id          String   @id @default(uuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        String // erp | rfq
  sha256      String
  fromAddress String?
  subject     String?
  // received | processed | rejected | failed | needs_mapping
  status      String   @default("received")
  // What was done or why not, for the integrations page.
  detail      Json?
  receivedAt  DateTime @default(now())

  @@unique([orgId, sha256])
  @@index([orgId, receivedAt])
}

// One recurring ERP report (recognised by its header row) and how its
// columns map to Takumo's data, confirmed once by the shop.
model ErpReport {
  id             String    @id @default(uuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String // the attachment's name, e.g. "Open Jobs.xlsx"
  headerKey      String // hash of its normalised header row
  headers        String[]
  entity         String // an ingest EntityKey
  mapping        Json? // ColumnMapping, once confirmed
  // full: the report lists everything (open orders missing from it are done);
  // changes: only what changed.
  mode           String    @default("full")
  // needs_mapping | active | paused
  status         String    @default("needs_mapping")
  // The rows waiting for the mapping to be confirmed (latest file only).
  pending        Json?
  lastReceivedAt DateTime?
  lastImportAt   DateTime?
  lastResult     Json?
  lastAlertAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orgId, headerKey])
}

// Stock on hand per material and location, from the ERP.
model StockLevel {
  id           String    @id @default(uuid())
  orgId        String
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  location     String    @default("")
  qtyOnHand    Float
  qtyAllocated Float     @default(0)
  unit         String?
  asOf         DateTime  @default(now())
  syncedAt     DateTime?

  @@unique([orgId, materialId, location])
  @@index([orgId])
}

// Open purchase-order lines for material, from the ERP.
model PurchaseOrderLine {
  id          String    @id @default(uuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  poNo        String
  lineNo      Int       @default(1)
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  supplier    String?
  qtyOrdered  Float
  qtyReceived Float     @default(0)
  unit        String?
  // Price per unit on the PO, and when it was ordered (material pricing).
  unitPrice   Float?
  orderedAt   DateTime? @db.Date
  dueDate     DateTime  @db.Date
  // open | partial | received | cancelled
  status      String    @default("open")
  syncedAt    DateTime?

  @@unique([orgId, poNo, lineNo])
  @@index([orgId, dueDate])
}

// ---------------------------------------------------------------------------
// Morning brief and alerts (docs/PRODUCT-PLAN.md Phase 4)
// ---------------------------------------------------------------------------

// One person's brief and alert settings in one shop. No row: the defaults
// (brief on at 06:30, every section and alert on).
model NotifyPrefs {
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String // WorkOS user ID
  briefOn     Boolean  @default(true)
  // Local time the brief goes out, HH:MM, on weekdays.
  briefTime   String   @default("06:30")
  // IANA time zone, e.g. America/Chicago.
  timeZone    String   @default("America/Chicago")
  // Brief sections turned off (late, bottleneck, quotes, facts, material, sync).
  briefOff    String[] @default([])
  // Alert types turned off (late, down, material, rfq).
  alertsOff   String[] @default([])
  // Local date (YYYY-MM-DD) of the last brief, sent or empty, so it goes once a day.
  lastBriefOn String?
  updatedAt   DateTime @updatedAt

  @@id([orgId, userId])
}

// Approve / reject / won / lost links in emails are single use: the nonce of
// each one used.
model EmailLinkUse {
  nonce  String   @id
  orgId  String
  org    Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  action String
  usedAt DateTime @default(now())

  @@index([orgId])
}

// A link in a brief someone clicked (how often briefs are read; no open pixels).
model BriefClick {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  section   String
  clickedAt DateTime @default(now())

  @@index([orgId, clickedAt])
}

// When alerts last looked at a shop: orders and RFQs newer than this are new.
model AlertWatch {
  orgId     String   @id
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checkedAt DateTime
}

// Something worth an alert, found once (type + key never repeat). `quiet`:
// found on the shop's first check, so it was already true before alerts began.
model AlertEvent {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // late | down | material | rfq
  type      String
  key       String
  message   String
  path      String
  quiet     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([orgId, type, key])
  @@index([orgId, createdAt])
}

// When each person last got each type of alert (at most one an hour).
model AlertSent {
  orgId  String
  org    Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  type   String
  sentAt DateTime

  @@id([orgId, userId, type])
}

// ---------------------------------------------------------------------------
// Notes by text message (F6.1)
// ---------------------------------------------------------------------------

// A phone that may send voice notes and texts to the shop's Takumo number.
// Registered in the app, then confirmed with a code sent to it by SMS.
model PhoneNumber {
  id            String    @id @default(uuid())
  orgId         String
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // E.164, e.g. +15551234567.
  phone         String
  // Who it belongs to: their name, and their Takumo login or roster entry.
  name          String
  userId        String?
  operatorId    String?
  // The confirmation code (hashed), while it's being confirmed.
  codeHash      String?
  codeSentAt    DateTime?
  codeExpiresAt DateTime?
  attempts      Int       @default(0)
  verifiedAt    DateTime?
  addedBy       String?
  createdAt     DateTime  @default(now())

  messages PhoneMessage[]

  @@unique([orgId, phone])
  @@index([phone])
}

// One message from a registered phone, once (Twilio retries by MessageSid).
model PhoneMessage {
  id         String      @id @default(uuid())
  orgId      String
  org        Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phoneId    String
  phone      PhoneNumber @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  sid        String      @unique
  // sms | whatsapp
  channel    String
  // received | processed | failed
  status     String      @default("received")
  noteId     String?
  error      String?
  receivedAt DateTime    @default(now())

  @@index([orgId, receivedAt])
}
