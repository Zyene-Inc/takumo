{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/skip-ci.js",
  "crons": [
    {
      "path": "/api/cron/recalibrate",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/connectors",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/erp-health",
      "schedule": "0 15 * * *"
    }
  ]
}
